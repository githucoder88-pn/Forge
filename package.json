{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge — open-source AI engineering platform: autonomous coding agents, teams, model routing, real-time orchestration.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/forge-electron"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "demo": "node packages/forge-cli/bin/forge.js demo",
    "serve": "node packages/forge-cli/bin/forge.js serve"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
