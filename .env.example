# Copy to .env (never commit real keys). All optional unless noted.
OPENAI_API_KEY=sk-...                    # required for provider 'openai'
OPENAI_BASE_URL=https://api.openai.com/v1
FORGE_PROVIDER=openai                    # openai | mock
FORGE_MODEL=gpt-4o-mini
FORGE_PORT=8710
FORGE_HOST=127.0.0.1
FORGE_DATA_DIR=~/.forge
FORGE_CORE_URL=http://127.0.0.1:8710     # CLI/GUI: which Core to use
FORGE_TOKEN=                             # set to require a bearer token
FORGE_AUTO_APPROVE=0                     # 1 = auto-approve gates (dangerous)
FORGE_LOG_LEVEL=info                     # trace|debug|info|warn|error
FORGE_MAX_ITERS=40
FORGE_CMD_TIMEOUT=120000
